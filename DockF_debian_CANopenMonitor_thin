FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    can-utils \
    iproute2 \
    nano \
    libcdk5-dev \
    libncurses5-dev \
    && rm -rf /var/lib/apt/lists/*

ENV TMPDIR=/workspace/tmp

WORKDIR /workspace

RUN mkdir -p /workspace/tmp

CMD ["bash"]
